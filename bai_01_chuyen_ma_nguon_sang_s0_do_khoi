#include <stdio.h>
#include <math.h>


int main() {
    int a, b, c;
    scanf("%d%d%d", &a, &b, &c);


    if (a == 0) {
        if (b == 0) {
            if (c == 0)
                printf("VSN");
            else
                printf("VN");  
        } else {
            float x = -(float)c / b;
            printf("x = %.2f", x);
        }
    } else {
        int delta = b * b - 4 * a * c;


        if (delta == 0) {
            printf("x1 = x2 = %.2f", -(float)b / (2 * a));
        } else if (delta < 0) {
            printf("VN");
        } else {
            float x1 = (-b - sqrt(delta)) / (2.0 * a);
            float x2 = (-b + sqrt(delta)) / (2.0 * a);
            printf("x1 = %.2f x2 = %.2f", x1, x2);
        }
    }


    return 0;
}
